{% extends "base.html.j2" %}
{% block title %}AI settings — JobOS{% endblock %}
{% block content %}
<h1>AI settings</h1>
<p class="subtle">
  Choose the provider and model JobOS uses for job analysis, bullet rewriting, and cover
  letters. Every AI task has a deterministic fallback, so the workflow still completes if the
  model is unavailable. Changes are validated and a timestamped config backup is kept.
</p>

<form method="post" action="/ai" data-busy="Saving...">
  <div class="card">
    <h2>Provider &amp; model</h2>
    <div class="grid two">
      <div>
        <label class="subtle" for="provider">Provider</label>
        <select id="provider" name="provider">
          {% for option in ai.providers %}
          <option value="{{ option }}" {{ 'selected' if option == ai.provider }}>{{ option }}</option>
          {% endfor %}
        </select>

        <div id="ollama-model-wrap" style="margin-top:10px">
          <label class="subtle" for="model_select">Ollama model
            <button type="button" class="btn small" id="refresh-models" style="margin-left:6px">Refresh</button>
          </label>
          <select id="model_select" name="model_select">
            <option value="">— use the text field below —</option>
            {% for name in ollama_models %}
            <option value="{{ name }}" {{ 'selected' if name == ai.model }}>{{ name }}</option>
            {% endfor %}
          </select>
          {% if not ollama_models %}
          <p class="subtle" style="margin-top:4px">
            No models found. Is Ollama running? Pull one with <code>ollama pull &lt;model&gt;</code>,
            then Refresh. You can also type the model name below.
          </p>
          {% endif %}
        </div>

        <label class="subtle" for="model" style="margin-top:10px">Model name (free text)</label>
        <input type="text" id="model" name="model" value="{{ ai.model }}"
               placeholder="e.g. llama3.2 or gpt-4o-mini">
      </div>
      <div>
        <label class="subtle" for="base_url">Base URL</label>
        <input type="text" id="base_url" name="base_url" value="{{ ai.base_url }}">
        <p class="subtle" style="margin-top:4px">
          Ollama defaults to <code>http://127.0.0.1:11434</code>. Leave the loopback value for
          cloud providers and JobOS routes to their official endpoint automatically.
        </p>

        <h3 style="margin-top:14px">API keys</h3>
        <p class="subtle">
          Keys are saved to a local <code>.env</code> file (gitignored, owner-only) —
          never to <code>config.yaml</code> and never shown back here. You can also set
          the environment variable in your shell instead.
        </p>
        <ul class="plain key-list">
          {% for provider, status in ai.key_status.items() %}
          <li class="key-row">
            <code>{{ status.variable }}</code>
            {% if status.present %}<span class="badge">set</span>{% else %}<span class="badge">not set</span>{% endif %}
            {# Each key has its own tiny form so saving one does not submit the main
               settings form. The value is write-only: never rendered back. #}
            <form method="post" action="/ai/key" class="key-form inline">
              <input type="hidden" name="provider" value="{{ provider }}">
              <input type="password" name="api_key" autocomplete="off"
                     placeholder="{{ 'replace key' if status.present else 'paste key' }}"
                     aria-label="API key for {{ provider }}">
              <button type="submit" class="btn small">Save</button>
            </form>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Generation limits</h2>
    <div class="grid two">
      <div>
        <label class="subtle" for="temperature">Temperature</label>
        <input type="number" step="0.1" min="0" max="2" id="temperature" name="temperature" value="{{ ai.temperature }}">
        <label class="subtle" for="timeout_seconds" style="margin-top:10px">Timeout (seconds)</label>
        <input type="number" step="1" min="1" id="timeout_seconds" name="timeout_seconds" value="{{ ai.timeout_seconds }}">
        <label class="subtle" for="keep_alive" style="margin-top:10px">Keep alive</label>
        <input type="text" id="keep_alive" name="keep_alive" value="{{ ai.keep_alive }}">
      </div>
      <div>
        <label class="subtle" for="max_input_chars">Max input chars</label>
        <input type="number" step="500" min="500" id="max_input_chars" name="max_input_chars" value="{{ ai.max_input_chars }}">
        <label class="subtle" for="max_output_tokens" style="margin-top:10px">Max output tokens</label>
        <input type="number" step="64" min="64" id="max_output_tokens" name="max_output_tokens" value="{{ ai.max_output_tokens }}">
        <label class="subtle" for="max_bullet_rewrites" style="margin-top:10px">Max bullet rewrites</label>
        <input type="number" step="1" min="0" id="max_bullet_rewrites" name="max_bullet_rewrites" value="{{ ai.max_bullet_rewrites }}">
        <label style="display:block;margin-top:10px">
          <input type="checkbox" name="disable_thinking" {{ 'checked' if ai.disable_thinking }}>
          Disable model "thinking" (recommended for structured output)
        </label>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>AI tasks</h2>
    <p class="subtle">Turn individual AI tasks on or off. Each has a deterministic fallback.</p>
    <ul class="plain">
      <li><label><input type="checkbox" name="structure_resume" {{ 'checked' if ai.tasks.structure_resume }}> Structure uploaded resume (PDF/DOCX → schema)</label></li>
      <li><label><input type="checkbox" name="analyse_jobs" {{ 'checked' if ai.tasks.analyse_jobs }}> Analyse jobs (classify required vs preferred skills)</label></li>
      <li><label><input type="checkbox" name="rewrite_summary" {{ 'checked' if ai.tasks.rewrite_summary }}> Rewrite summary <span class="subtle">(off keeps your summary verbatim)</span></label></li>
      <li><label><input type="checkbox" name="rewrite_bullets" {{ 'checked' if ai.tasks.rewrite_bullets }}> Rewrite bullets <span class="subtle">(off only reorders, never rewords)</span></label></li>
      <li><label><input type="checkbox" name="cover_letter" {{ 'checked' if ai.tasks.cover_letter }}> Draft cover letters</label></li>
    </ul>
  </div>

  <div class="actions">
    <button type="submit" class="btn primary">Save AI settings</button>
  </div>
</form>

<script>
(function () {
  var providerSelect = document.getElementById("provider");
  var ollamaWrap = document.getElementById("ollama-model-wrap");
  var refreshBtn = document.getElementById("refresh-models");
  var modelSelect = document.getElementById("model_select");

  function syncProvider() {
    // The Ollama model dropdown only makes sense for the Ollama provider.
    var isOllama = providerSelect.value === "ollama";
    ollamaWrap.style.display = isOllama ? "" : "none";
  }
  providerSelect.addEventListener("change", syncProvider);
  syncProvider();

  if (refreshBtn) {
    refreshBtn.addEventListener("click", async function () {
      refreshBtn.disabled = true;
      refreshBtn.textContent = "Refreshing...";
      try {
        var res = await fetch("/ai/ollama-models");
        var data = await res.json();
        var current = modelSelect.value;
        modelSelect.innerHTML = '<option value="">— use the text field below —</option>';
        (data.models || []).forEach(function (name) {
          var opt = document.createElement("option");
          opt.value = name; opt.textContent = name;
          if (name === current) opt.selected = true;
          modelSelect.appendChild(opt);
        });
      } catch (err) {
        /* leave the existing options in place on failure */
      } finally {
        refreshBtn.disabled = false;
        refreshBtn.textContent = "Refresh";
      }
    });
  }
})();
</script>
{% endblock %}
