{% extends "base.html.j2" %}
{% block title %}Review changes — JobOS{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Review before generating</h1>
    <p class="subtle">
      {{ job.company }} · {{ job.title }} · application {{ application.id }} ·
      <span class="badge">{{ application.status.value }}</span>
    </p>
  </div>
  <div class="spacer"></div>
  <div style="text-align:right">
    <div class="subtle">ATS estimate</div>
    <div style="font-size:1.5rem">
      {{ application.ats_before.overall_score }} &rarr;
      <span class="score {{ application.ats_after.overall_score | score_band }}">{{ application.ats_after.overall_score }}</span>
    </div>
  </div>
</div>

{% if warnings %}
<div class="flash warn">
  <ul>{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
</div>
{% endif %}

{% if application.status.value == 'approved' %}
<div class="flash info">
  Generated in <code>{{ application.output_dir }}</code>.
  <div class="actions" style="margin-top:8px">
    {% for name in artifacts %}
    <a class="btn small" href="/applications/{{ application.id }}/files/{{ name }}" target="_blank" rel="noopener">{{ name }}</a>
    {% endfor %}
    {% if 'resume.pdf' in artifacts %}
    <a class="btn small" href="/applications/{{ application.id }}/files/resume.pdf?download=1">Download PDF</a>
    {% endif %}
  </div>
</div>

{% if 'resume.pdf' in artifacts %}
<div class="card">
  <h2>Tailored resume</h2>
  <object class="pdf-preview" data="/applications/{{ application.id }}/files/resume.pdf" type="application/pdf">
    <p class="subtle">
      Your browser will not display the PDF inline.
      <a href="/applications/{{ application.id }}/files/resume.pdf" target="_blank" rel="noopener">Open it in a new tab</a>.
    </p>
  </object>
</div>
{% endif %}
{% else %}
<div class="card">
  <div class="page-head">
    <div>
      <h2 style="margin-top:0">Edit, preview &amp; generate — all here</h2>
      <p class="subtle">
        Tweak the tailored resume as YAML, see the live preview, then generate the package —
        without leaving this page. These are your own edits (schema-validated); the master
        resume is never touched. Nothing is written to <code>output/</code> until you generate.
      </p>
    </div>
    <div class="spacer"></div>
    <div class="actions">
      <button type="button" class="btn small" id="preview-btn">Preview</button>
      <button type="submit" class="btn small" form="resume-edit-form">Save edits</button>
      <form method="post" action="/applications/{{ application.id }}/approve" class="inline"
            data-busy="Rendering PDF...">
        <button type="submit" class="btn small primary">Generate package</button>
      </form>
    </div>
  </div>
  <p class="subtle" style="margin:0 0 10px">
    Tip: Save edits first, then Generate — Generate uses the last saved version.
    <a href="/jobs/{{ job.id }}">Back to job</a>
  </p>
  <div class="grid two">
    <form method="post" action="/applications/{{ application.id }}/resume" id="resume-edit-form"
          data-busy="Saving...">
      <label class="subtle" for="resume_yaml">Tailored resume (YAML)</label>
      <textarea id="resume_yaml" name="resume_yaml" spellcheck="false"
                style="width:100%;min-height:520px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;line-height:1.45;white-space:pre;overflow:auto;">{{ resume_yaml }}</textarea>
    </form>
    <div>
      <label class="subtle">Live preview</label>
      <div id="preview-error" class="flash warn" style="display:none"></div>
      <iframe id="resume-preview" title="Resume preview"
              style="width:100%;min-height:520px;border:1px solid var(--border,#2a2a2a);border-radius:8px;background:#fff;"></iframe>
    </div>
  </div>
</div>

<script>
(function () {
  var editor = document.getElementById("resume_yaml");
  var frame = document.getElementById("resume-preview");
  var errorBox = document.getElementById("preview-error");
  var button = document.getElementById("preview-btn");
  if (!editor || !frame) return;
  var timer = null;
  async function refresh() {
    var body = new URLSearchParams(); body.set("resume_yaml", editor.value);
    try {
      var res = await fetch("/applications/{{ application.id }}/preview", {
        method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      });
      var text = await res.text();
      if (res.ok) { errorBox.style.display = "none"; frame.srcdoc = text; }
      else { errorBox.textContent = text || ("Preview failed (" + res.status + ")"); errorBox.style.display = ""; }
    } catch (err) { errorBox.textContent = "Preview request failed: " + err; errorBox.style.display = ""; }
  }
  editor.addEventListener("input", function () {
    if (timer) clearTimeout(timer);
    timer = setTimeout(refresh, 600);
  });
  if (button) button.addEventListener("click", refresh);
  refresh();  // show current version on load
})();
</script>
{% endif %}

<div class="card">
  <h2>Summary</h2>
  {% if diff.summary_before != diff.summary_after %}
  <div class="diff-before"><b>Before:</b> {{ diff.summary_before or '(empty)' }}</div>
  <div class="diff-after"><b>After:</b> {{ diff.summary_after or '(empty)' }}</div>
  {% else %}
  <p class="subtle">Unchanged.</p>
  {% endif %}
</div>

<div class="card">
  <h2>Reworded bullets ({{ diff.bullet_changes | length }})</h2>
  {% for change in diff.bullet_changes %}
  <h3><code>{{ change.bullet_id }}</code></h3>
  <div class="diff-before">{{ change.before }}</div>
  <div class="diff-after">{{ change.after }}</div>
  {% else %}
  <p class="subtle">No wording changed. Facts and numbers are always preserved.</p>
  {% endfor %}
</div>

<div class="card">
  <h2>Reordering</h2>
  <ul class="plain">
    {% for item in diff.ordering_changes %}<li>{{ item }}</li>
    {% else %}<li class="subtle">No reordering.</li>{% endfor %}
  </ul>
  {% if diff.skill_order_before != diff.skill_order_after %}
  <h3>Skill order</h3>
  <div class="diff-before">{{ diff.skill_order_before | join(' • ') or '(none)' }}</div>
  <div class="diff-after">{{ diff.skill_order_after | join(' • ') or '(none)' }}</div>
  {% endif %}
</div>

<div class="card">
  <h2>Rejected edits ({{ diff.rejected_edits | length }})</h2>
  <p class="subtle">
    Blocked because your resume does not support them. This is the guardrail working, not an error.
  </p>
  {% for rejected in diff.rejected_edits %}
  <h3><code>{{ rejected.target }}</code></h3>
  <div class="diff-before rejected"><b>Reason:</b> {{ rejected.reason }}</div>
  {% if rejected.proposed_text %}
  <div class="diff-before rejected"><b>Proposed:</b> {{ rejected.proposed_text }}</div>
  {% endif %}
  {% else %}
  <p class="subtle">None.</p>
  {% endfor %}
</div>

{% if application.cover_letter %}
<div class="card">
  <h2>Cover letter</h2>
  <pre>{{ application.cover_letter.markdown }}</pre>
  {% if application.cover_letter.fact_sources %}
  <p class="subtle">Grounded in: {{ application.cover_letter.fact_sources | join(', ') }}</p>
  {% endif %}
  {% if application.cover_letter.warnings %}
  <ul class="plain">
    {% for item in application.cover_letter.warnings %}<li class="subtle">{{ item }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

{% if application.plan.explanations %}
<div class="card">
  <h2>Why these changes</h2>
  <ul class="plain">
    {% for item in application.plan.explanations %}<li>{{ item }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

{% endblock %}
