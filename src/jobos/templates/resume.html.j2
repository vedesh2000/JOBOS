{#
  Single-column, ATS-friendly resume. Deliberately plain: standard headings, no
  tables for layout, no icons, no remote assets, selectable text only.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ resume.contact.name }} — Resume</title>
<style>
  @page { size: {{ page_size }}; margin: {{ margin }}; }
  * { box-sizing: border-box; }
  body {
    font-family: {{ font_stack }};
    font-size: {{ base_font_size }};
    line-height: {{ line_height | default('1.42') }};
    color: #111;
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
  h1 { font-size: {{ name_font_size | default('1.65em') }}; margin: 0 0 2px; letter-spacing: 0.2px; }
  h2 {
    font-size: {{ heading_font_size | default('0.95em') }};
    text-transform: uppercase;
    letter-spacing: 0.9px;
    margin: {{ section_gap | default('15px') }} 0 6px;
    padding-bottom: 3px;
    border-bottom: 1px solid #999;
  }
  h3 { font-size: 1em; margin: {{ entry_head_gap | default('9px') }} 0 1px; }
  h3 .company { font-weight: 700; }
  p { margin: 0 0 6px; }
  ul { margin: 4px 0 6px; padding-left: 17px; }
  li { margin-bottom: {{ li_gap | default('3px') }}; }
  /* Understated dark links. In rich mode contact/profile links are real <a>
     anchors so Chromium emits clickable PDF annotations. */
  a { color: #1a3b5c; text-decoration: none; }
  a:hover { text-decoration: underline; }
  strong { font-weight: 700; }
  .contact { font-size: 0.92em; margin-bottom: 2px; }
  .contact span:not(:last-child)::after { content: " • "; color: #666; }
  .entry { margin-bottom: {{ entry_gap | default('8px') }}; }
  .entry-head { display: flex; justify-content: space-between; gap: 12px; }
  .entry-meta { font-size: 0.9em; color: #333; white-space: nowrap; }
  .entry-sub { font-size: 0.92em; color: #333; }
  .inline-list { margin: 0 0 6px; }
  .tech { font-size: 0.9em; color: #333; }
  /* Keep a single entry from splitting, but let long sections flow across a page
     break so a large section does not get pushed wholesale onto the next page. */
  h2 { break-after: avoid; }
  .entry { break-inside: avoid; }
</style>
</head>
<body>
<header>
  <h1>{{ resume.contact.name }}</h1>
  <div class="contact">
    {% if resume.contact.email %}
      {% set mail = resume.contact.email | safe_link %}
      <span>{% if mail %}<a href="{{ mail.href }}">{{ resume.contact.email }}</a>{% else %}{{ resume.contact.email }}{% endif %}</span>
    {% endif %}
    {% if resume.contact.phone %}<span>{{ resume.contact.phone }}</span>{% endif %}
    {% if resume.contact.location %}<span>{{ resume.contact.location }}</span>{% endif %}
    {% for link in resume.contact.links %}
      {% set safe = link | safe_link %}
      <span>{% if safe %}<a href="{{ safe.href }}">{{ safe.label }}</a>{% else %}{{ link }}{% endif %}</span>
    {% endfor %}
  </div>
</header>

{% if resume.summary %}
<section>
  <h2>Summary</h2>
  <p>{{ resume.summary }}</p>
</section>
{% endif %}

{% if resume.experience %}
<section>
  <h2>Experience</h2>
  {% for job in resume.experience %}
  <div class="entry">
    <div class="entry-head">
      <h3>{{ job.title }}{% if job.company %} — <span class="company">{{ job.company }}</span>{% endif %}</h3>
      {% if job.start_date or job.end_date %}
      <div class="entry-meta">{{ job.start_date }}{% if job.end_date %} – {{ job.end_date }}{% endif %}</div>
      {% endif %}
    </div>
    {% if job.location %}<div class="entry-sub">{{ job.location }}</div>{% endif %}
    {% if job.bullets %}
    <ul>
      {% for bullet in job.bullets %}<li>{% if rich %}{{ bullet.text | emphasize(job.skills) }}{% else %}{{ bullet.text }}{% endif %}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if job.skills %}<div class="tech">Technologies: {{ job.skills | join(', ') }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if resume.projects %}
<section>
  <h2>Projects</h2>
  {% for project in resume.projects %}
  <div class="entry">
    <h3>{{ project.name }}</h3>
    {% if project.url %}
      {% set plink = project.url | safe_link %}
      <div class="entry-sub">{% if plink %}<a href="{{ plink.href }}">{{ plink.label }}</a>{% else %}{{ project.url }}{% endif %}</div>
    {% endif %}
    {% if project.description %}<p>{{ project.description }}</p>{% endif %}
    {% if project.bullets %}
    <ul>
      {% for bullet in project.bullets %}<li>{% if rich %}{{ bullet.text | emphasize(project.skills) }}{% else %}{{ bullet.text }}{% endif %}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if project.skills %}<div class="tech">Technologies: {{ project.skills | join(', ') }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if resume.skill_groups %}
<section>
  <h2>Skills</h2>
  {% for label, items in resume.skill_groups.items() %}
  {% if items %}<p class="inline-list"><strong>{{ label }}:</strong> {{ items | join(', ') }}</p>{% endif %}
  {% endfor %}
</section>
{% elif resume.skills %}
<section>
  <h2>Skills</h2>
  <p class="inline-list">{{ resume.skills | join(' • ') }}</p>
</section>
{% endif %}

{% if rich %}
{# Readable themes: inline achievements and fold certifications into one compact
   section, so six one-per-row bullets plus a separate section heading become ~2-3
   lines — the space that would otherwise be spent on headings goes back to real
   experience bullets. #}
{% if resume.achievements or resume.certifications %}
<section>
  <h2>
    {%- if resume.achievements and resume.certifications -%}Achievements &amp; Certifications
    {%- elif resume.achievements -%}Achievements
    {%- else -%}Certifications{%- endif -%}
  </h2>
  {% if resume.achievements %}
  <p class="inline-list">{{ resume.achievements | map(attribute='text') | join(' • ') }}</p>
  {% endif %}
  {% if resume.certifications %}
  <p class="inline-list">
    {% if resume.achievements %}<strong>Certifications:</strong> {% endif %}
    {%- for item in resume.certifications -%}
    {{ item.name }}{% if item.issuer %} ({{ item.issuer }}){% endif %}{% if item.date %} ({{ item.date }}){% endif %}{% if not loop.last %} • {% endif %}
    {%- endfor -%}
  </p>
  {% endif %}
</section>
{% endif %}
{% else %}
{% if resume.achievements %}
<section>
  <h2>Achievements</h2>
  <ul>
    {% for item in resume.achievements %}<li>{{ item.text }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

{% if resume.certifications %}
<section>
  <h2>Certifications</h2>
  <p class="inline-list">
    {%- for item in resume.certifications -%}
    {{ item.name }}{% if item.issuer %} ({{ item.issuer }}){% endif %}{% if item.date %} ({{ item.date }}){% endif %}{% if not loop.last %} • {% endif %}
    {%- endfor -%}
  </p>
</section>
{% endif %}
{% endif %}

{% if resume.education %}
<section>
  <h2>Education</h2>
  {% for item in resume.education %}
  <div class="entry">
    <div class="entry-head">
      <h3>{{ item.degree }}{% if item.field %} — {{ item.field }}{% endif %}</h3>
      {% if item.start_date or item.end_date %}
      <div class="entry-meta">{{ item.start_date }}{% if item.end_date %} – {{ item.end_date }}{% endif %}</div>
      {% endif %}
    </div>
    {% if item.institution %}<div class="entry-sub">{{ item.institution }}</div>{% endif %}
    {% if item.details %}
    <ul>
      {% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if resume.languages %}
<section>
  <h2>Languages</h2>
  <p class="inline-list">{{ resume.languages | join(' • ') }}</p>
</section>
{% endif %}

{% for name, lines in resume.additional_sections.items() %}
{% if lines %}
<section>
  <h2>{{ name | replace('_', ' ') | title }}</h2>
  <ul>
    {% for line in lines %}<li>{{ line }}</li>{% endfor %}
  </ul>
</section>
{% endif %}
{% endfor %}
</body>
</html>
