{% extends "base.html.j2" %}
{% block title %}Jobs — JobOS{% endblock %}
{% block content %}
{% if not has_resume %}
<div class="flash info">
  Browse and crawl jobs freely. To <b>score</b> a job against you and <b>tailor</b> a
  resume for it, <a href="/resume">add your master resume</a> — it takes a minute.
</div>
{% endif %}
<div class="page-head">
  <div>
    <h1>Jobs</h1>
    <p class="subtle">{{ total }} matching {{ 'job' if total == 1 else 'jobs' }} stored locally.</p>
  </div>
  <div class="spacer"></div>
</div>

<div class="card crawl-panel">
  <div class="crawl-panel-head">
    <h2>Fetch jobs</h2>
    <p class="subtle">
      Crawling reads the current openings from your companies' job boards into this
      local list — it never submits anything. Pick what to crawl, or paste one URL.
    </p>
  </div>
  <form method="post" action="/crawl" class="crawl-fields" id="crawl-form">
    <label class="field">Company
      <select name="company" aria-label="Company to crawl">
        <option value="">All configured companies</option>
        {% for slug, company in configured.items() %}
        <option value="{{ slug }}">{{ company.name }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field" title="Crawl only one speed tier at a time. Fast finishes in a minute; slow (Workday) is the long tail.">Speed wave
      <select name="ats" aria-label="Crawl speed wave">
        {% for value, label in waves %}
        <option value="{{ value }}">{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field grow">Or paste a careers URL
      <input type="url" name="url" class="url-input" inputmode="url"
             placeholder="https://boards.greenhouse.io/acme" aria-label="Career page URL to crawl">
    </label>
    <div class="crawl-actions">
      <button type="submit" class="btn primary" {% if crawl.running %}disabled{% endif %}>
        Crawl
      </button>
      <button type="button" id="crawl-waves-btn" class="btn"
              title="Crawl fast boards first (apply right away), then medium and slow behind you"
              {% if crawl.running %}disabled{% endif %}>
        Crawl all in waves
      </button>
    </div>
  </form>
  <p class="subtle crawl-hint" style="margin:12px 0 0">
    <b>Crawl</b> fetches the selected company (or wave) now. <b>Crawl all in waves</b>
    runs fast → medium → slow in order, so you can start applying to the fast results
    while the slower Workday boards keep loading — you'll get a notification as each
    wave finishes. Re-crawls only update what changed. Manage boards on
    <a href="/organizations">Organizations</a>.
  {% if closed_jobs %}
  <form method="post" action="/jobs/clear-closed" class="inline"
        data-confirm="Permanently delete {{ closed_jobs }} closed job(s)? Jobs tied to a prepared application or report are kept."
        style="display:inline">
    · <button type="submit" class="btn small">Delete {{ closed_jobs }} closed job{{ '' if closed_jobs == 1 else 's' }}</button>
  </form>
  {% endif %}
  </p>
</div>

<details class="card add-company">
  <summary>Paste a job description</summary>
  <p class="subtle">
    For roles on career portals the crawler can't read (custom sites, LinkedIn, etc.),
    paste the job description here to analyse, score, and optimise against it. The URL is
    optional — add it so "Apply" opens the right page.
  </p>
  <form method="post" action="/jobs/paste" data-busy="Adding job...">
    <div class="actions">
      <label class="field">Job title
        <input type="text" name="title" required placeholder="AI Engineer">
      </label>
      <label class="field">Company
        <input type="text" name="company" required placeholder="NetApp">
      </label>
      <label class="field">Apply URL <span class="subtle">(optional)</span>
        <input type="url" name="url" class="url-input" placeholder="https://jobs.netapp.com/…">
      </label>
    </div>
    <label class="field" style="display:block;margin-top:8px">Job description
      <textarea name="description" required rows="8" spellcheck="false"
                style="width:100%;font-family:inherit;font-size:13px;line-height:1.4"
                placeholder="Paste the full job description here…"></textarea>
    </label>
    <button type="submit" class="btn primary" style="margin-top:8px">Add &amp; analyse</button>
  </form>
</details>

{% if not configured %}
<div class="flash warn">
  No companies configured yet. Add them under <code>companies:</code> in your
  <code>config.yaml</code>, then crawl.
</div>
{% endif %}

<div id="crawl-live" data-status-url="/api/crawl" data-running="{{ 'true' if crawl.running else 'false' }}">
{% if crawl.running %}
<div class="flash info">
  <span class="spinner" aria-hidden="true"></span>
  Crawling {{ crawl.label }}… this can take a minute. <span class="subtle">Reload to see new jobs.</span>
</div>
{% elif crawl.error %}
<div class="flash error">Last crawl failed: {{ crawl.error }}</div>
{% elif crawl.summary %}
<div class="flash info">
  Last crawl finished {{ crawl.finished_at }}: {{ crawl.summary.jobs_added }} added,
  {{ crawl.summary.jobs_updated }} updated, {{ crawl.summary.jobs_closed }} closed across
  {{ crawl.summary.companies_succeeded }}/{{ crawl.summary.companies_requested }} companies.
  {% if crawl.summary.errors %}
  <ul>
    {% for name, message in crawl.summary.errors.items() %}<li><b>{{ name }}</b>: {{ message }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}
</div>

<div class="stats">
  <div class="stat">
    <b>{{ jobs | length }}{% if page and page.total > (jobs | length) %} <span class="subtle">of {{ page.total }}</span>{% endif %}</b>
    <span>Shown</span>
  </div>
  <div class="stat"><b>{{ scored }}</b><span>Scored</span></div>
  <div class="stat"><b>{{ companies | length }}</b><span>Companies</span></div>
  <div class="stat"><b>{{ min_score }}</b><span>Min score</span></div>
</div>

<div class="card">
  <form method="get" action="/" class="filters">
    <label class="field">Search
      <input type="search" name="q" value="{{ query.q }}" placeholder="python, remote, aws, 5 years">
    </label>
    <label class="field">Company
      <select name="company">
        <option value="">Any</option>
        {% for name in companies %}
        <option value="{{ name }}" {{ 'selected' if query.company == name }}>{{ name }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Location
      <input type="text" name="location" value="{{ query.location }}" placeholder="Hyderabad">
    </label>
    <label class="field">Skills
      <input type="text" name="skills" value="{{ query.skills }}" placeholder="python, react">
    </label>
    <label class="field">Exclude skills
      <input type="text" name="exclude_skills" value="{{ query.exclude_skills }}" placeholder="java, spring boot">
    </label>
    <label class="field">Status
      <select name="status">
        <option value="">Any</option>
        {% for value in statuses %}
        <option value="{{ value }}" {{ 'selected' if query.status == value }}>{{ value }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Min score
      <input type="number" name="min_score" min="0" max="100" value="{{ query.min_score }}">
    </label>
    <label class="field">Max years
      <input type="number" name="max_years" min="0" max="60" value="{{ query.max_years }}">
    </label>
    <label class="field" title="When JobOS first saw the posting — your daily 'what's new' filter.">New within
      <select name="new_within">
        {% for value, label in new_within_options %}
        <option value="{{ value }}" {{ 'selected' if query.new_within == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field" title="Uses the employer's own publish date. Boards that do not report one are skipped.">Posted within
      <select name="posted_days">
        <option value="">Any time</option>
        {% for value, label in [('1', 'Last 24 hours'), ('3', 'Last 3 days'), ('5', 'Last 5 days'), ('7', 'Last week'), ('14', 'Last 2 weeks'), ('30', 'Last 30 days')] %}
        <option value="{{ value }}" {{ 'selected' if query.posted_days == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Sort
      <select name="sort">
        {% for value, label in sorts %}
        <option value="{{ value }}" {{ 'selected' if query.sort == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field check" title="Apply the preferences from your config.yaml: roles, skills, locations, years, and minimum score.">
      <input type="checkbox" name="preferred" value="on" {{ 'checked' if query.preferred }}>
      Preferred only
    </label>
    <button type="submit" class="btn primary">Apply</button>
    <a class="btn" href="/?preferred=on">Reset</a>
  </form>
</div>

<div class="card">
  {% if jobs %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Company</th>
          <th>Role</th>
          <th>Location</th>
          <th class="nowrap">Posted</th>
          <th class="nowrap">Years</th>
          <th class="nowrap">Match</th>
          <th>Status</th>
          <th class="nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for job in jobs %}
        <tr>
          <td>{{ job.company }}</td>
          <td><a href="/jobs/{{ job.id }}">{{ job.title }}</a></td>
          <td>{{ job.location or '—' }}</td>
          <td class="nowrap">
            {% if job.posted_at %}
            <span class="{{ 'fresh' if job.posted_at | posted_age_days <= 5 }}">{{ job.posted_at | posted_age }}</span>
            {% else %}
            <span class="subtle" title="This board does not publish a date.">unknown</span>
            {% endif %}
          </td>
          <td class="nowrap">
            {% if job.min_years is not none %}
            <span class="yrs" title="Minimum years of experience the posting asks for">{{ job.min_years | int }}+ yrs</span>
            {% else %}
            <span class="subtle" title="Not stated in the posting.">—</span>
            {% endif %}
          </td>
          <td class="nowrap">
            {% if job.match_score is none %}
            <span class="subtle">not scored</span>
            {% else %}
            <span class="score {{ job.match_score | score_band }}">{{ job.match_score }}</span>
            <div class="bar"><i style="width: {{ job.match_score }}%"></i></div>
            {% endif %}
          </td>
          <td class="nowrap">
            {# Inline status: change it right here during triage, no need to open the job. #}
            <form method="post" action="/jobs/{{ job.id }}/status" class="inline status-form">
              <input type="hidden" name="next" value="/?{{ query_string }}">
              <select name="status" class="status-select status-{{ job.status.value }}"
                      aria-label="Status for {{ job.title }}">
                {% for value in statuses %}
                <option value="{{ value }}" {{ 'selected' if job.status.value == value }}>{{ value }}</option>
                {% endfor %}
              </select>
              <noscript><button type="submit" class="btn small">Set</button></noscript>
            </form>
          </td>
          <td class="nowrap">
            <div class="actions">
              <a class="btn small" href="/jobs/{{ job.id }}">Open</a>
              <form method="post" action="/jobs/{{ job.id }}/apply" class="inline">
                <button type="submit" class="btn small primary">Apply</button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if page and page.page_count > 1 %}
  {# Carry the active filters across page links so paging never resets them. #}
  {% set base = "?q=" ~ (query.q | urlencode)
      ~ "&company=" ~ (query.company | urlencode)
      ~ "&location=" ~ (query.location | urlencode)
      ~ "&status=" ~ (query.status | urlencode)
      ~ "&min_score=" ~ (query.min_score | urlencode)
      ~ "&max_years=" ~ (query.max_years | urlencode)
      ~ "&skills=" ~ (query.skills | urlencode)
      ~ "&exclude_skills=" ~ (query.exclude_skills | urlencode)
      ~ "&posted_days=" ~ (query.posted_days | urlencode)
      ~ "&new_within=" ~ (query.new_within | urlencode)
      ~ "&sort=" ~ (query.sort | urlencode)
      ~ ("&preferred=on" if preferred else "") %}
  <nav class="pager" aria-label="Job results pages">
    {% if page.has_prev %}
    <a class="btn small" href="{{ base }}&page={{ page.page_number - 1 }}">← Previous</a>
    {% else %}
    <span class="btn small disabled" aria-disabled="true">← Previous</span>
    {% endif %}
    <span class="subtle">
      Showing {{ page.showing_from }}–{{ page.showing_to }} of {{ page.total }}
      (page {{ page.page_number }} of {{ page.page_count }})
    </span>
    {% if page.has_next %}
    <a class="btn small" href="{{ base }}&page={{ page.page_number + 1 }}">Next →</a>
    {% else %}
    <span class="btn small disabled" aria-disabled="true">Next →</span>
    {% endif %}
  </nav>
  {% endif %}
  {% else %}
  <p class="empty">
    No jobs match these filters.
    {% if configured %}Try a crawl or clear the filters.{% endif %}
  </p>
  {% endif %}
</div>
{% endblock %}
