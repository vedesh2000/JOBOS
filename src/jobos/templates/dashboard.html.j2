{% extends "base.html.j2" %}
{% block title %}Jobs — JobOS{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Jobs</h1>
    <p class="subtle">{{ total }} matching {{ 'job' if total == 1 else 'jobs' }} stored locally.</p>
  </div>
  <div class="spacer"></div>
  <form method="post" action="/crawl" class="actions" id="crawl-form">
    <select name="company" aria-label="Company to crawl">
      <option value="">All configured companies</option>
      {% for slug, company in configured.items() %}
      <option value="{{ slug }}">{{ company.name }}</option>
      {% endfor %}
    </select>
    <input type="url" name="url" class="url-input" inputmode="url"
           placeholder="…or paste any careers URL" aria-label="Career page URL to crawl">
    <button type="submit" class="btn primary" {% if crawl.running %}disabled{% endif %}>
      Crawl
    </button>
  </form>
</div>
<p class="subtle crawl-hint">
  Pick a configured company, or paste any careers page or job-board URL to crawl it
  once. Greenhouse, Lever, Ashby, SmartRecruiters and Workday links work best; other
  sites are read where the page exposes its postings.
</p>

<details class="card add-company">
  <summary>Add a company permanently</summary>
  <p class="subtle">
    Saves it under <code>companies:</code> in <code>{{ config_path }}</code>, so every
    future crawl includes it. A one-off URL crawl above is not saved.
  </p>
  <form method="post" action="/companies" class="actions" data-busy="Adding...">
    <label class="field">Careers URL
      <input type="url" name="url" required class="url-input"
             placeholder="https://boards.greenhouse.io/acme">
    </label>
    <label class="field">Name <span class="subtle">(optional)</span>
      <input type="text" name="name" placeholder="Derived from the URL">
    </label>
    <label class="field check">
      <input type="checkbox" name="crawl" value="1" checked> Crawl it now
    </label>
    <button type="submit" class="btn primary">Add company</button>
  </form>
</details>

{% if not configured %}
<div class="flash warn">
  No companies configured yet. Add them under <code>companies:</code> in
  <code>{{ config_path }}</code>, then crawl.
</div>
{% endif %}

<div id="crawl-live" data-status-url="/api/crawl" data-running="{{ 'true' if crawl.running else 'false' }}">
{% if crawl.running %}
<div class="flash info">
  <span class="spinner" aria-hidden="true"></span>
  Crawling {{ crawl.label }}… this can take a minute. <span class="subtle">Reload to see new jobs.</span>
</div>
{% elif crawl.error %}
<div class="flash error">Last crawl failed: {{ crawl.error }}</div>
{% elif crawl.summary %}
<div class="flash info">
  Last crawl finished {{ crawl.finished_at }}: {{ crawl.summary.jobs_added }} added,
  {{ crawl.summary.jobs_updated }} updated, {{ crawl.summary.jobs_closed }} closed across
  {{ crawl.summary.companies_succeeded }}/{{ crawl.summary.companies_requested }} companies.
  {% if crawl.summary.errors %}
  <ul>
    {% for name, message in crawl.summary.errors.items() %}<li><b>{{ name }}</b>: {{ message }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}
</div>

<div class="stats">
  <div class="stat"><b>{{ total }}</b><span>Shown</span></div>
  <div class="stat"><b>{{ scored }}</b><span>Scored</span></div>
  <div class="stat"><b>{{ companies | length }}</b><span>Companies</span></div>
  <div class="stat"><b>{{ min_score }}</b><span>Min score</span></div>
</div>

<div class="card">
  <form method="get" action="/" class="filters">
    <label class="field">Search
      <input type="search" name="q" value="{{ query.q }}" placeholder="python, remote, aws, 5 years">
    </label>
    <label class="field">Company
      <select name="company">
        <option value="">Any</option>
        {% for name in companies %}
        <option value="{{ name }}" {{ 'selected' if query.company == name }}>{{ name }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Location
      <input type="text" name="location" value="{{ query.location }}" placeholder="Hyderabad">
    </label>
    <label class="field">Skills
      <input type="text" name="skills" value="{{ query.skills }}" placeholder="python, react">
    </label>
    <label class="field">Exclude skills
      <input type="text" name="exclude_skills" value="{{ query.exclude_skills }}" placeholder="java, spring boot">
    </label>
    <label class="field">Status
      <select name="status">
        <option value="">Any</option>
        {% for value in statuses %}
        <option value="{{ value }}" {{ 'selected' if query.status == value }}>{{ value }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Min score
      <input type="number" name="min_score" min="0" max="100" value="{{ query.min_score }}">
    </label>
    <label class="field">Max years
      <input type="number" name="max_years" min="0" max="60" value="{{ query.max_years }}">
    </label>
    <label class="field" title="Uses the employer's own publish date. Boards that do not report one are skipped.">Posted within
      <select name="posted_days">
        <option value="">Any time</option>
        {% for value, label in [('1', 'Last 24 hours'), ('3', 'Last 3 days'), ('5', 'Last 5 days'), ('7', 'Last week'), ('14', 'Last 2 weeks'), ('30', 'Last 30 days')] %}
        <option value="{{ value }}" {{ 'selected' if query.posted_days == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field">Sort
      <select name="sort">
        {% for value, label in sorts %}
        <option value="{{ value }}" {{ 'selected' if query.sort == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="field check" title="Apply the preferences from your config.yaml: roles, skills, locations, years, and minimum score.">
      <input type="checkbox" name="preferred" value="on" {{ 'checked' if query.preferred }}>
      Preferred only
    </label>
    <button type="submit" class="btn primary">Apply</button>
    <a class="btn" href="/?preferred=on">Reset</a>
  </form>
</div>

<div class="card">
  {% if jobs %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Company</th>
          <th>Role</th>
          <th>Location</th>
          <th class="nowrap">Posted</th>
          <th class="nowrap">Match</th>
          <th>Status</th>
          <th class="nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for job in jobs %}
        <tr>
          <td>{{ job.company }}</td>
          <td><a href="/jobs/{{ job.id }}">{{ job.title }}</a></td>
          <td>{{ job.location or '—' }}</td>
          <td class="nowrap">
            {% if job.posted_at %}
            <span class="{{ 'fresh' if job.posted_at | posted_age_days <= 5 }}">{{ job.posted_at | posted_age }}</span>
            {% else %}
            <span class="subtle" title="This board does not publish a date.">unknown</span>
            {% endif %}
          </td>
          <td class="nowrap">
            {% if job.match_score is none %}
            <span class="subtle">not scored</span>
            {% else %}
            <span class="score {{ job.match_score | score_band }}">{{ job.match_score }}</span>
            <div class="bar"><i style="width: {{ job.match_score }}%"></i></div>
            {% endif %}
          </td>
          <td><span class="badge">{{ job.status.value }}</span></td>
          <td class="nowrap">
            <div class="actions">
              <a class="btn small" href="/jobs/{{ job.id }}">Open</a>
              <form method="post" action="/jobs/{{ job.id }}/apply" class="inline">
                <button type="submit" class="btn small primary">Apply</button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty">
    No jobs match these filters.
    {% if configured %}Try a crawl or clear the filters.{% endif %}
  </p>
  {% endif %}
</div>
{% endblock %}
